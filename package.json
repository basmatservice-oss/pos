{
  "name": "smart-pos-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "dev:electron": "concurrently \"npm:dev\" \"wait-on http://localhost:3000/api/health && cross-env NODE_ENV=development electron .\"",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rimraf dist release",
    "start": "tsx server.ts",
    "build:server": "esbuild server.ts --bundle --platform=node --target=node16 --format=cjs --outfile=dist/server.cjs --external:better-sqlite3 --external:vite",
    "package:win": "npm run build:native && npm run test:native-bundle && npm run build:server && electron-builder --win nsis --x64 --publish never",
    "cap:sync": "cap sync android",
    "cap:open": "cap open android",
    "lint": "tsc --noEmit",
    "test:unit": "node --import tsx --test tests/*.test.js tests/*.test.ts",
    "build:native": "cross-env POS_NATIVE_SQLITE_BUILD=1 vite build",
    "test:native-bundle": "node tests/native-bundle-check.cjs"
  },
  "dependencies": {
    "@capacitor/android": "7.4.3",
    "@capacitor/core": "7.4.3",
    "@google/genai": "^1.29.0",
    "@supabase/supabase-js": "2.39.8",
    "@tailwindcss/vite": "^4.1.14",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.13.6",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "8.7.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.2",
    "express": "^4.22.1",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.1.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-barcode": "^1.6.1",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.13.1",
    "react-to-print": "^3.3.0",
    "recharts": "^3.8.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.5.0",
    "tsx": "^4.21.0",
    "uuid": "9.0.1",
    "vite": "^6.2.0",
    "zustand": "^5.0.11",
    "@capacitor-mlkit/barcode-scanning": "^7.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "7.4.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.31.10",
    "electron": "22.3.27",
    "electron-builder": "24.13.3",
    "electron-rebuild": "^3.2.9",
    "esbuild": "^0.27.4",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "wait-on": "^9.0.4",
    "dexie": "^4.3.0"
  },
  "build": {
    "appId": "com.smartpos.studio",
    "productName": "Smart POS Studio",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "drizzle/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "dist/**/*",
      "node_modules/better-sqlite3/**/*",
      "drizzle/migrations/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Smart-POS-Setup-${version}-win-x64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
