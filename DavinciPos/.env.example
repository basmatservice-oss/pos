# Copy to .env and configure the local HTTPS certificate.
# 0.0.0.0 listens on the host's network interfaces; no internet connection is required.
HOST=0.0.0.0
PORT=3000
TLS_CERT_PATH=./lan-cert.pem
TLS_KEY_PATH=./lan-key.pem
DAVINCIPOS_DB=./DavinciPos.sqlite
DAVINCIPOS_BOOTSTRAP_TOKEN=replace-with-a-long-random-one-time-token
